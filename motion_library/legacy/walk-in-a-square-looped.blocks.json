{
  "format": "uni-edu-studio-block-example-v1",
  "controller_version": "legacy",
  "name": "walk-in-a-square-looped",
  "title": "Walk in a Square",
  "blocks": [
    {
      "type": "g1_command_stand",
      "method": "stand",
      "inputs": []
    },
    {
      "type": "controls_repeat_ext",
      "method": "repeat",
      "times": 4,
      "body": [
        {
          "type": "g1_command_walk",
          "method": "walk",
          "inputs": [
            "2"
          ]
        },
        {
          "type": "g1_command_turn",
          "method": "turn",
          "inputs": [
            "\"left\"",
            "90"
          ]
        },
        {
          "type": "g1_command_wait",
          "method": "wait",
          "inputs": [
            "2"
          ]
        }
      ]
    }
  ]
}
